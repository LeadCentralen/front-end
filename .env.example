
# Skrapningsskydd (valfritt, här standardvärden)
# LIMIT_DEPTH=500          rader som en sökning visar
# LIMIT_ROWS_DAY=3000      olika företag en användare får se per dygn
# LIMIT_DETAILS_DAY=300    öppnade företagskort per dygn
# LIMIT_LEADS_DAY=100      leads som läggs i tavlan per dygn
# LIMIT_SEARCH_MIN=40      sökningar per minut
# LIMIT_DETAIL_MIN=30      öppnade företag per minut

# Inloggning
# SESSION_IDLE_MIN=30        minuter utan aktivitet innan användaren loggas ut
# CONCURRENT_WINDOW_MIN=5    en inloggning på en andra enhet inom så många minuter räknas som varning

# Organisationer
# ALLOW_SIGNUP=1     0 stänger den öppna registreringen på startsidan
